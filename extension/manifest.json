{
  "manifest_version": 3,
  "name": "FocusFlow Companion",
  "version": "1.0.0",
  "description": "Chrome extension companion for FocusFlow. Syncs timers and blocks distracting sites.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "activeTab",
    "idle",
    "notifications"
  ],
  "host_permissions": [
    "https://focusflow-backend-liuf.onrender.com/*",
    "https://focus-flow-flame-five.vercel.app/*",
    "http://localhost:5000/*",
    "http://localhost:5173/*",
    "http://localhost:5174/*"
  ],
  "icons": {
    "16": "assets/icon128.png",
    "48": "assets/icon128.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon128.png",
      "48": "assets/icon128.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
